# Telegram
BOT_TOKEN=
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Generate once: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_ENCRYPTION_KEY=
WEBHOOK_BASE_URL=
WEBHOOK_SECRET=

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/elonbot
DATABASE_SSL=false

# Administration (comma-separated Telegram user IDs)
# Telegram user IDs allowed to open /admin and activate the 20000 UZS / 30 day plan.
ADMIN_IDS=

# Rate and product limits
MAX_MESSAGES_PER_MINUTE=20
MAX_MESSAGES_PER_CHAT_PER_MINUTE=1
MAX_ACTIVE_ANNOUNCEMENTS_PER_USER=10
# Connected groups are unlimited. Per-announcement limits and prices are in Admin > Tariffs.
# Legacy MAX_GROUPS_PER_ANNOUNCEMENT is ignored.

# Application
APP_ENV=development
# Public landing page: defaults to WEBHOOK_BASE_URL if omitted (origin only).
# PUBLIC_SITE_URL=https://your-domain.uz
PUBLIC_BOT_USERNAME=elonyuborishbot
# Information channel: public URL or invite link. Empty value hides its buttons.
# If omitted, the configured Elonbot channel below is used.
PUBLIC_CHANNEL_URL=https://t.me/+XE6Z-NQakcJkYjRi
# Defaults to true in production, false in development. Keep staging unindexed.
# SITE_INDEXABLE=false
PORT=8000
# Local Caddy only; use 0.0.0.0 for a managed host/container with protected ingress.
HOST=127.0.0.1
# Exact IPs of proxies allowed to append X-Forwarded-For; empty disables trust.
TRUSTED_PROXY_IPS=127.0.0.1,::1

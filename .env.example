# Telegram
BOT_TOKEN=
WEBHOOK_BASE_URL=
WEBHOOK_SECRET=

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/elonbot

# Administration (comma-separated Telegram user IDs)
ADMIN_IDS=

# Rate and product limits
MAX_MESSAGES_PER_MINUTE=20
MAX_MESSAGES_PER_CHAT_PER_MINUTE=1
MAX_ACTIVE_ANNOUNCEMENTS_PER_USER=10
MAX_GROUPS_PER_USER=20
MAX_DELIVERIES_PER_USER_PER_DAY=500

# Application
APP_ENV=development
LOG_LEVEL=INFO

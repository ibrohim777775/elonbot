# Telegram
BOT_TOKEN=
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Generate once: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_ENCRYPTION_KEY=
WEBHOOK_BASE_URL=
WEBHOOK_SECRET=

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/elonbot
DATABASE_SSL=false

# Administration (comma-separated Telegram user IDs)
# Telegram user IDs allowed to open /admin and activate the 20000 UZS / 30 day plan.
ADMIN_IDS=

# Rate and product limits
MAX_MESSAGES_PER_MINUTE=20
MAX_MESSAGES_PER_CHAT_PER_MINUTE=1
MAX_ACTIVE_ANNOUNCEMENTS_PER_USER=10
# Connected groups are unlimited; this limits recipients of each announcement.
MAX_GROUPS_PER_ANNOUNCEMENT=30

# Application
APP_ENV=development
PORT=8000
# Local Caddy only; use 0.0.0.0 for a managed host/container with protected ingress.
HOST=127.0.0.1
# Exact IPs of proxies allowed to append X-Forwarded-For; empty disables trust.
TRUSTED_PROXY_IPS=127.0.0.1,::1
